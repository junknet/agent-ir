{
  "name": "agent-ir",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "Protocol-neutral IR for multi-protocol LLM gateways: ingress decode -> IR -> egress lower/lift.",
  "scripts": {
    "dev": "bun run src/main.ts",
    "test": "bun test",
    "typecheck": "tsc --noEmit"
  },
  "devDependencies": {
    "@types/bun": "latest",
    "@types/node": "latest",
    "typescript": "latest"
  },
  "exports": {
    ".": "./src/index.ts",
    "./egress/windsurf": "./src/egress/windsurf/index.ts",
    "./egress/windsurf/web-search": "./src/egress/windsurf/web_search.ts"
  },
  "dependencies": {
    "@bufbuild/protobuf": "^2.2.3",
    "pino": "^10.3.1",
    "pino-pretty": "^13.1.3"
  }
}
